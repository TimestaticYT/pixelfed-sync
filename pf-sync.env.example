# Copy to pf-sync.env next to run.sh and uncomment what you want to change.
# Values shown are the defaults.

# Container and app path (auto-detected when unset)
#PF_SYNC_WEB_CONTAINER="my-pixelfed-web"
#PF_SYNC_APP_ROOT="/var/www"

# Opening or following a remote account: fetch its newest public media posts
#PF_SYNC_BACKFILL_LIMIT=20
# Re-sync followed accounts (and allow re-backfilling opened ones) this often
#PF_SYNC_RESYNC_HOURS=6

# Scrolling to the end of a remote profile loads older posts
#PF_SYNC_SCROLL_BACKFILL=true
#PF_SYNC_SCROLL_BATCH=20
# Stop loading older posts once this many are stored for an account
#PF_SYNC_SCROLL_MAX_POSTS=240

# Opening a remote post fetches its comments and like/repost/comment counts
#PF_SYNC_POST_DETAILS=true
#PF_SYNC_POST_REPLIES_MAX=40
#PF_SYNC_POST_COOLDOWN_MINUTES=10

# Trending posts for the global timeline (space-separated Mastodon-style status list URLs)
#PF_SYNC_TRENDING=true
#PF_SYNC_TRENDING_INTERVAL_MINUTES=30
#PF_SYNC_TRENDING_MAX_PER_RUN=80
#PF_SYNC_TRENDING_SKIP_SENSITIVE=true
# Only take trending posts with at least this many likes
#PF_SYNC_TRENDING_MIN_LIKES=10
# Default: daily trending of pixelfed.social, pixelfed.de, pixelfed.art, pixelfed.fr,
# pixelfed.au, pixelfed.uno and metapixl.com. Mastodon's trends are photo-light;
# add https://mastodon.social/api/v1/trends/statuses?limit=40 if you want them.
#PF_SYNC_TRENDING_SOURCES="https://pixelfed.social/api/pixelfed/v2/discover/posts/trending?range=daily https://pixelfed.de/api/pixelfed/v2/discover/posts/trending?range=daily"
# Also put backfilled posts (opened/followed/scrolled accounts) in the global timeline
#PF_SYNC_BACKFILL_IN_GLOBAL=false

# "Liked by" / "Shared by": import who liked and shared a remote post when the list is opened
#PF_SYNC_LIKERS=true
#PF_SYNC_LIKERS_MAX=40

# Account index: crawl public directories (opt-in "discoverable" accounts only)
# so search and Discover > Popular accounts can find popular remote accounts
#PF_SYNC_INDEX=true
#PF_SYNC_INDEX_INTERVAL_HOURS=24
#PF_SYNC_INDEX_PAGES=10
#PF_SYNC_INDEX_MIN_FOLLOWERS=1000
#PF_SYNC_INDEX_MAX_PER_RUN=200
#PF_SYNC_INDEX_SOURCES="https://mastodon.social https://mastodon.online https://mstdn.social https://mas.to https://fosstodon.org"

# Search lookup: a name searched on this server (3+ characters) is also looked
# up on these servers and the most followed matches are imported.
# This sends search terms to those servers; set to false to keep them local.
#PF_SYNC_SEARCH_LOOKUP=true
#PF_SYNC_SEARCH_SERVERS="https://mastodon.social"
#PF_SYNC_SEARCH_MAX_IMPORTS=5
#PF_SYNC_SEARCH_MIN_FOLLOWERS=10
